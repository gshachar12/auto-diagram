  actorUngrounded: {
    style: {
      fill: "#e3e9f7"
      stroke: "#5b6fb8"
      stroke-width: 2
      font-color: "#1c2540"
    }
  }
  edgeGrounded: {
    style: {
      stroke: "#2e9e44"
      stroke-width: 2
    }
  }
  edgeUnsupported: {
    style: {
      stroke: "#c0392b"
      stroke-dash: 4
      stroke-width: 2
    }
  }
  edgeUncertain: {
    style: {
      stroke: "#d4a017"
      stroke-dash: 2
      stroke-width: 2
    }
  }
  edgeUngrounded: {
    style: {
      stroke: "#8a94ad"
      stroke-dash: 6
      stroke-width: 1
    }
  }
  noteGrounded: {
    style: {
      fill: "#f6fbf0"
      stroke: "#2e9e44"
      stroke-dash: 3
      font-color: "#27500a"
      font-size: 12
    }
  }
  noteUnsupported: {
    style: {
      fill: "#fff5f5"
      stroke: "#c0392b"
      stroke-dash: 3
      font-color: "#501313"
      font-size: 12
    }
  }
  noteUncertain: {
    style: {
      fill: "#fffaf0"
      stroke: "#d4a017"
      stroke-dash: 3
      font-color: "#5c4300"
      font-size: 12
    }
  }
  noteUngrounded: {
    style: {
      fill: "#f4f6f9"
      stroke: "#8a94ad"
      stroke-dash: 3
      font-color: "#3a4152"
      font-size: 12
    }
  }
}

title: { label: "PAnGEA -- extracted traffic"; near: top-center }

victim_client: "victim_client\n(victim)" {
  shape: person
  icon: https://img.icons8.com/color/96/laptop.png
  class: actorResolved
  tooltip: "description: Victim (client)\nresolved to: 10.0.2.30\nresolution basis: Joint LLM resolution: The IP 10.0.2.30 is primarily sending DNS requests to 10.0.2.20, which is consistent with the behavior of a client querying a DNS server. The role of 'victim client' suggests it is the one initiating requests, matching the pattern of 10.0.2.30."
}
attacker_c2: "attacker_c2\n(attacker C2 server)" {
  shape: person
  icon: https://img.icons8.com/color/96/evil.png
  class: actorResolved
  tooltip: "description: Attacker C2 (rogue DNS)\nresolved to: 10.0.2.20\nresolution basis: Joint LLM resolution: The IP 10.0.2.20 is primarily responding to DNS requests from 10.0.2.30, which aligns with the behavior of a DNS server. Given the role of 'attacker C2 server' as a rogue DNS, 10.0.2.20 fits this role as it is acting as a DNS server."
}
attacker_controlled_domain: "attacker_controlled_domain\n(attacker-controlled domain)" {
  shape: person
  icon: https://img.icons8.com/color/96/evil.png
  class: actorUnresolved
  tooltip: "description: Attacker-controlled domain: pirate.sea\nUNRESOLVED -- no matching endpoint found\nresolution basis: The role 'attacker-controlled domain' refers to a domain name rather than an IP address. The provided IPs do not directly correlate to a domain name, and there is no specific evidence linking either IP to the domain 'pirate.sea'."
}

