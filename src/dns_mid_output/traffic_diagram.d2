# PAnGEA -- extracted traffic
classes: {
  actorResolved: {
    style: {
      fill: "#d6f5d6"
      stroke: "#2e9e44"
      stroke-width: 2
      font-color: "#14401c"
    }
  }
  actorUnresolved: {
    style: {
      fill: "#f9d6d6"
      stroke: "#c0392b"
      stroke-width: 2
      font-color: "#4a1414"
    }
  }
  actorUngrounded: {
    style: {
      fill: "#eceff1"
      stroke: "#90a4ae"
      stroke-width: 1
      font-color: "#37474f"
    }
  }
  edgeGrounded: {
    style: {
      stroke: "#2e9e44"
      stroke-width: 2
    }
  }
  edgeUnsupported: {
    style: {
      stroke: "#c0392b"
      stroke-dash: 4
      stroke-width: 2
    }
  }
  edgeUncertain: {
    style: {
      stroke: "#d4a017"
      stroke-dash: 2
      stroke-width: 2
    }
  }
  edgeUngrounded: {
    style: {
      stroke: "#90a4ae"
      stroke-dash: 6
      stroke-width: 1
    }
  }
  note: {
    shape: "page"
    style: {
      fill: "#fff8dc"
      stroke: "#d4a017"
      font-size: 12
    }
  }
}

title: { label: "PAnGEA -- extracted traffic"; near: top-center }

victim_client: "victim_client\n(victim)" {
  class: actorResolved
  tooltip: "description: Victim (client)\nresolved to: 10.0.2.30\nresolution basis: Joint LLM resolution: The IP 10.0.2.30 is consistently initiating DNS requests to 10.0.2.20, which is typical behavior for a client querying a DNS server. This aligns with the role of a victim client."
}
attacker_c2: "attacker_c2\n(attacker C2 server)" {
  class: actorResolved
  tooltip: "description: Attacker C2 (rogue DNS)\nresolved to: 10.0.2.20\nresolution basis: Joint LLM resolution: The IP 10.0.2.20 is responding to DNS queries from 10.0.2.30, which suggests it is acting as a DNS server. Given the context of an attacker C2 server using rogue DNS, this IP fits the role of the attacker C2 server."
}
attacker_domain: "attacker_domain\n(attacker-controlled domain)" {
  class: actorUnresolved
  tooltip: "description: Attacker-controlled domain\nUNRESOLVED -- no matching endpoint found\nresolution basis: There is no specific evidence in the provided data to identify an IP as an attacker-controlled domain distinct from the roles already assigned. Both IPs are involved in DNS traffic, but neither is clearly acting as a domain itself."
}

