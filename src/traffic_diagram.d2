# PAnGEA -- extracted traffic
shape: sequence_diagram

classes: {
  actorResolved: {
    style: {
      fill: "#d6f5d6"
      stroke: "#2e9e44"
      stroke-width: 2
      font-color: "#14401c"
    }
  }
  actorUnresolved: {
    style: {
      fill: "#f9d6d6"
      stroke: "#c0392b"
      stroke-width: 2
      font-color: "#4a1414"
    }
  }
  actorUngrounded: {
    style: {
      fill: "#e3e9f7"
      stroke: "#5b6fb8"
      stroke-width: 2
      font-color: "#1c2540"
    }
  }
