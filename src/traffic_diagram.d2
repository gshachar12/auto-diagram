    style: {
      stroke: "#2e9e44"
      stroke-width: 2
    }
  }
  edgeUnsupported: {
    style: {
      stroke: "#c0392b"
      stroke-dash: 4
      stroke-width: 2
    }
  }
  edgeUncertain: {
    style: {
      stroke: "#d4a017"
      stroke-dash: 2
      stroke-width: 2
    }
  }
  edgeUngrounded: {
    style: {
      stroke: "#8a94ad"
      stroke-dash: 6
      stroke-width: 1
    }
  }
  noteGrounded: {
    style: {
      fill: "#f6fbf0"
      stroke: "#2e9e44"
      stroke-dash: 3
      font-color: "#27500a"
      font-size: 12
    }
  }
  noteUnsupported: {
    style: {
      fill: "#fff5f5"
      stroke: "#c0392b"
      stroke-dash: 3
      font-color: "#501313"
      font-size: 12
    }
  }
  noteUncertain: {
    style: {
      fill: "#fffaf0"
      stroke: "#d4a017"
      stroke-dash: 3
      font-color: "#5c4300"
      font-size: 12
    }
  }
  noteUngrounded: {
    style: {
      fill: "#f4f6f9"
      stroke: "#8a94ad"
      stroke-dash: 3
      font-color: "#3a4152"
      font-size: 12
    }
  }
}

title: { label: "PAnGEA -- extracted traffic"; near: top-center }

victim_host: "victim_host\n(victim)" {
  shape: person
  icon: https://img.icons8.com/color/96/laptop.png
  class: actorResolved
  tooltip: "description: the victim host\nresolved to: 10.12.13.103\nresolution basis: Joint LLM resolution: The IP 10.12.13.103 has the highest number of packets as a destination, indicating it is likely the victim host receiving traffic from multiple sources. It also initiates connections to other IPs, which is typical for a victim host interacting with various servers."
}
remote_web_server: "remote_web_server\n(web server)" {
  shape: rectangle
  icon: https://img.icons8.com/color/96/server.png
  class: actorResolved
  tooltip: "description: a remote web server\nresolved to: 104.28.10.141\nresolution basis: Joint LLM resolution: The IP 104.28.10.141 is primarily contacted by 10.12.13.103 and serves as a destination for HTTP traffic on port 80, which is consistent with a web server role."
}
disposable_domain: "disposable_domain\n(malicious domain)" {
  shape: person
  icon: https://img.icons8.com/color/96/evil.png
  class: actorResolved
  tooltip: "description: a separate, disposable-looking domain\nresolved to: 37.10.71.202\nresolution basis: Joint LLM resolution: The IP 37.10.71.202 has minimal traffic and appears to be involved in a brief interaction, which is characteristic of a disposable domain used for short-term malicious activities."
}
