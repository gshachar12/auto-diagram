# PAnGEA -- extracted traffic
shape: sequence_diagram

classes: {
  actorResolved: {
    style: {
      fill: "#d6f5d6"
      stroke: "#2e9e44"
      stroke-width: 2
      font-color: "#14401c"
    }
  }
  actorUnresolved: {
    style: {
      fill: "#f9d6d6"
      stroke: "#c0392b"
      stroke-width: 2
      font-color: "#4a1414"
    }
  }
  actorUngrounded: {
    style: {
      fill: "#e3e9f7"
      stroke: "#5b6fb8"
      stroke-width: 2
      font-color: "#1c2540"
    }
  }
  edgeGrounded: {
    style: {
      stroke: "#2e9e44"
      stroke-width: 2
    }
  }
  edgeUnsupported: {
    style: {
      stroke: "#c0392b"
      stroke-dash: 4
      stroke-width: 2
    }
  }
  edgeUncertain: {
    style: {
      stroke: "#d4a017"
      stroke-dash: 2
      stroke-width: 2
    }
  }
  edgeUngrounded: {
    style: {
      stroke: "#8a94ad"
      stroke-dash: 6
      stroke-width: 1
    }
  }
  noteGrounded: {
    style: {
      fill: "#f6fbf0"
      stroke: "#2e9e44"
      stroke-dash: 3
      font-color: "#27500a"
      font-size: 12
    }
  }
  noteUnsupported: {
    style: {
      fill: "#fff5f5"
      stroke: "#c0392b"
      stroke-dash: 3
      font-color: "#501313"
      font-size: 12
    }
  }
  noteUncertain: {
    style: {
      fill: "#fffaf0"
      stroke: "#d4a017"
      stroke-dash: 3
      font-color: "#5c4300"
      font-size: 12
    }
  }
  noteUngrounded: {
    style: {
      fill: "#f4f6f9"
      stroke: "#8a94ad"
      stroke-dash: 3
      font-color: "#3a4152"
      font-size: 12
    }
  }
}

title: { label: "PAnGEA -- extracted traffic"; near: top-center }

local_hosts: "local_hosts\n(local hosts)" {
  shape: rectangle
  icon: https://img.icons8.com/color/96/server.png
  class: actorResolved
  tooltip: "description: local hosts interacting within default domains on a private IP space\nresolved to: 192.168.1.104\nresolution basis: Joint LLM resolution: 192.168.1.104 is a private IP address with significant traffic volume, interacting with multiple external IPs, which is typical for a local host in a network."
}
network_nodes: "network_nodes\n(active network nodes)" {
  shape: person
  icon: https://img.icons8.com/color/96/user.png
  class: actorResolved
  tooltip: "description: active network nodes identified and mapped by hardware MAC address to logical IP address\nresolved to: 192.168.1.105\nresolution basis: Joint LLM resolution: 192.168.1.105 shows ARP activity and is involved in anomaly claims, suggesting it is an active network node with a mapped MAC address."
}
kali_host: "kali_host\n(offensive framework host)" {
  shape: rectangle
  icon: https://img.icons8.com/color/96/server.png
  class: actorUnresolved
  tooltip: "description: an offensive framework host named 'kali'\nUNRESOLVED -- no matching endpoint found\nresolution basis: There is no specific evidence pointing to an IP associated with an offensive framework host named 'kali'."
}
default_gateway: "default_gateway\n(default gateway)" {
  shape: hexagon
  icon: https://img.icons8.com/color/96/router.png
  class: actorResolved
  tooltip: "description: default gateway's IP address\nresolved to: 192.168.1.1\nresolution basis: Joint LLM resolution: 192.168.1.1 is a typical IP for a default gateway, and it shows ARP activity consistent with a gateway role."
}
victim_hosts: "victim_hosts\n(victim hosts)" {
  shape: person
  icon: https://img.icons8.com/color/96/laptop.png
  class: actorResolved
  tooltip: "description: target hosts whose ARP tables are altered\nresolved to: 192.168.1.104\nresolution basis: Joint LLM resolution: 192.168.1.104 is involved as a recipient in ARP anomalies, indicating it is a target of ARP table alterations."
}
dns_servers: "dns_servers\n(DNS servers)" {
  shape: rectangle
  icon: https://img.icons8.com/color/96/server.png
  class: actorResolved
  tooltip: "description: captures plain-text DNS queries on UDP Port 53\nresolved to: 192.168.1.1\nresolution basis: Joint LLM resolution: 192.168.1.1 has UDP traffic on port 53, which is typical for DNS server activity."
}
reddit_servers: "reddit_servers\n(reddit servers)" {
  shape: rectangle
  icon: https://img.icons8.com/color/96/server.png
  class: actorResolved
  tooltip: "description: web traffic for reddit.com and gql.reddit.com\nresolved to: 151.101.65.140\nresolution basis: Joint LLM resolution: 151.101.65.140 is associated with high-volume web traffic on port 443, consistent with a content delivery network serving reddit.com."
}
ntp_servers: "ntp_servers\n(NTP servers)" {
  shape: rectangle
  icon: https://img.icons8.com/color/96/server.png
  class: actorUnresolved
  tooltip: "description: lookups for hosts such as debian.pool.ntp.org\nUNRESOLVED -- no matching endpoint found\nresolution basis: There is no specific evidence pointing to an IP associated with NTP server activity for debian.pool.ntp.org."
}

